{
  "name": "@boardgames/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API client generated by Orval from the FastAPI OpenAPI schema",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "tsc -p .",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "axios": "~1.7.9"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "orval": "~7.3.0",
    "openapi-types": "~12.1.3",
    "rimraf": "~6.0.1"
  }
}
